{
  "name": "autonomia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Self-hosted OpenAI-compatible AI gateway with point-based billing, multi-provider pooling and a developer console.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:console": "npm run dev --workspace @autonomia/console",
    "dev:gateway": "node apps/gateway/src/nodeServer.ts",
    "dev:worker": "npm run dev:worker --workspace @autonomia/gateway",
    "deploy:worker": "npm run deploy:worker --workspace @autonomia/gateway",
    "migrate": "npm run migrate --workspace @autonomia/gateway",
    "revoke-sessions": "npm run revoke:sessions --workspace @autonomia/gateway",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start:gateway": "node apps/gateway/src/nodeServer.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "js-yaml": "^5.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3"
  },
  "overrides": {
    "jsdom": {
      "undici": "^8.12.2"
    },
    "miniflare": {
      "undici": "^7.30.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
